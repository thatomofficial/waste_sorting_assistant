# Staging Environment Configuration
# This file contains environment-specific variables for staging/QA

# API Configuration
API_BASE_URL=https://staging-api.wastesortingassistant.com
API_VERSION=v1
API_TIMEOUT=20

# Firebase Configuration
FIREBASE_PROJECT_ID=waste-sorting-staging
FIREBASE_API_KEY=staging-api-key
FIREBASE_APP_ID=staging-app-id
FIREBASE_MESSAGING_SENDER_ID=staging-sender-id

# ML Kit Configuration
USE_CLOUD_ML_KIT=true
ML_CONFIDENCE_THRESHOLD=0.8
MAX_IMAGE_SIZE=1024

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_DARK_MODE=true

# Performance Configuration
CACHE_SIZE_MB=30
CACHE_EXPIRY_HOURS=12
MAX_RETRY_ATTEMPTS=3

# Debug Configuration
ENABLE_DEBUG_LOGS=false
ENABLE_NETWORK_LOGS=false
ENABLE_PERFORMANCE_MONITORING=true

# App Configuration
APP_NAME=Waste Sorting Assistant (Staging)
APP_SUFFIX=-staging